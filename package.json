{
  "name": "serva-code",
  "version": "0.2.0",
  "description": "Serva Code \u2014 Local AI Software Company Operating System. Phase 2 Core Engine.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "serva": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs}\"",
    "catalogues": "node scripts/generate-catalogues.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "serva": "node dist/cli/main.js",
    "contracts": "node scripts/generate-agent-contracts.mjs",
    "generate": "npm run catalogues && npm run contracts",
    "test:claude": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
