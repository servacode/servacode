{
  "name": "serva-code",
  "version": "1.0.1",
  "description": "Serva Code \u2014 Local AI Software Company Operating System. Local-first, single-owner, VS Code native.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "serva": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts extension/src",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs}\" \"extension/src/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs}\" \"extension/src/**/*.ts\"",
    "catalogues": "node scripts/generate-catalogues.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && vitest run --reporter=json --outputFile=evidence/acceptance-run/offline-suite.json && npm run build",
    "serva": "node dist/cli/main.js",
    "contracts": "node scripts/generate-agent-contracts.mjs",
    "preflight": "node scripts/preflight.mjs",
    "prove": "node scripts/prove.mjs",
    "prove:live": "node scripts/prove-live.mjs",
    "security-review": "node scripts/security-review.mjs",
    "acceptance": "npm run build && npm run prove && node scripts/acceptance-matrix.mjs",
    "generate": "npm run catalogues && npm run contracts",
    "test:claude": "vitest run --config vitest.live.config.ts",
    "test:engineering-live": "vitest run --config vitest.engineering.config.ts",
    "test:intelligence-live": "vitest run --config vitest.intelligence.config.ts",
    "build:extension": "tsc -p extension/tsconfig.json && node scripts/copy-assets.mjs",
    "test:vscode": "node scripts/run-vscode-tests.mjs",
    "test:package": "vitest run --config vitest.package.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "validate:vsix": "node scripts/validate-vsix.mjs",
    "test:serva-live": "vitest run --config vitest.serva.config.ts",
    "test:serva-chain": "vitest run --config vitest.servachain.config.ts",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.12.0",
    "mocha": "^11.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "files": [
    "dist"
  ]
}
